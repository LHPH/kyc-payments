<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:pay="http://kyc-payments.com/PaymentTypes">
    <soapenv:Header>
        <wsse:Security xmlns:wsse="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd" wsse:mustUnderstand="1">
            <wsse:UsernameToken>
                <wsse:Username>USER</wsse:Username>
                <wsse:Password Type="http://oasis-open.org">PASS</wsse:Password>
            </wsse:UsernameToken>
            <wsse:BinarySecurityToken
            	ValueType="urn:ietf:params:oauth:token-type:jwt"
            	EncodingType="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-soap-message-security-1.0#Base64Binary">
            	TOKEN
            </wsse:BinarySecurityToken>
        </wsse:Security>
        <dev:DeviceData xmlns:dev="http://kyc-payments.com/HeaderTypes">
            <dev:device>MOBILE</dev:device>
        </dev:DeviceData>
    </soapenv:Header>
    <soapenv:Body>
        <pay:GetCustomerPaymentMethodRequest />
    </soapenv:Body>
</soapenv:Envelope>